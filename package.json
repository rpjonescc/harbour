{
  "name": "harbour",
  "private": true,
  "version": "0.1.0",
  "description": "A calm, private, self-hosted control centre for your projects: Tailscale + passkey secured, with a Paper & Tide design system.",
  "license": "MIT",
  "repository": "github:rpjonescc/harbour",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 3400",
    "build": "next build",
    "start": "next start -H 127.0.0.1 -p 3400",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "fix": "biome check --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check:files": "tsx scripts/check.ts",
    "check:private": "tsx scripts/check-private.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm check:files && pnpm check:private && pnpm test",
    "db:generate": "drizzle-kit generate",
    "setup-token": "tsx --env-file=.env scripts/setup-token.ts",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.3",
    "hast-util-to-string": "^3.0.1",
    "lucide-react": "^1.49.0",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "server-only": "^0.0.1",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "drizzle-kit": "^0.31.11",
    "jsdom": "^30.1.1",
    "lefthook": "^2.1.15",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  }
}
