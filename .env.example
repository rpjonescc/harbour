# Harbour configuration. Copy to .env and fill in; every variable is validated at startup.

# Comma-separated Tailscale logins allowed into Harbour (see `tailscale status --json` → User).
HARBOUR_ALLOWED_LOGINS=you@example.com
# Public origin and WebAuthn relying-party id: your machine's MagicDNS name.
# The origin's port is Harbour's Tailscale Serve port (HARBOUR_HTTPS_PORT for deploy/install.sh, default 8444).
HARBOUR_ORIGIN=https://your-pc.your-tailnet.ts.net:8444
HARBOUR_RP_ID=your-pc.your-tailnet.ts.net
HARBOUR_DB_PATH=./data/harbour.db
# Your products. By default Harbour reads ./harbour.config.json and, only if that file does not
# exist, shows harbour.config.example.json as a demo. Set this to read a different file; if set,
# the file must exist (no fallback).
# HARBOUR_CONFIG_PATH=./harbour.config.json
# IANA timezone and BCP 47 locale for dates (default en-US). Timezone defaults to the server's zone.
# HARBOUR_TIMEZONE=Europe/London
# HARBOUR_LOCALE=en-US
# Second Brain directory. Point this at a separate private git repo — your research and
# reports are personal data and must never be committed to the Harbour code repo.
HARBOUR_BRAIN_DIR=./brain
# "Open in editor" link for Second Brain documents; {path} is the absolute file path.
# Leave empty to hide the button.
# HARBOUR_EDITOR_URL_TEMPLATE=vscode://file/{path}
# Development only: put HARBOUR_DEV_IDENTITY=you@example.com in .env.development.local
# (loaded only by `next dev`). Production refuses to start if it is set.

# Agents (Phase 2b). Token: run `claude setup-token` and paste the result. Never commit it.
# After adding or changing it: systemctl --user restart harbour-web harbour-worker
# HARBOUR_CLAUDE_OAUTH_TOKEN=
# A command on the worker's PATH, or an absolute path to the Claude Code CLI.
# HARBOUR_CLAUDE_BIN=claude
# HARBOUR_AGENT_MODEL=claude-sonnet-5-5
# HARBOUR_AGENT_TIMEOUT_MINUTES=30

# Visibility scans (Phase 3). Most pages crawled per product per scan, 1 to 500.
# HARBOUR_CRAWL_MAX_PAGES=200
# Google API key restricted to the PageSpeed Insights API, for the weekly PageSpeed check (see
# "Connect PageSpeed" in README.md). Without one PageSpeed shows as not connected: keyless
# requests get no quota. Secret: never commit it. Restart the worker after changing it.
# HARBOUR_PAGESPEED_API_KEY=
# Google Search Console: absolute path to a service account key or OAuth authorized-user JSON
# file, kept outside the repo with mode 600 (see "Connect Search Console" in README.md). Also
# give each product a "searchConsoleProperty" in harbour.config.json. Restart the worker after.
# Never set GOOGLE_SDK_NODE_LOGGING for the worker: Google's auth library would log access tokens.
# HARBOUR_GSC_CREDENTIALS=
